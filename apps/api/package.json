    "@fastify/swagger-ui": "^4.1.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "prisma": "^5.18.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
